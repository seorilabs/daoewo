{
  "name": "daoewo",
  "version": "0.1.0",
  "private": true,
  "description": "다외워 — 스와이프와 간격 반복으로 무엇이든 외우는 멀티마켓 앱.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @daoewo/mobile start",
    "dev:mobile:preview": "pnpm --filter @daoewo/mobile start:preview",
    "generate:mobile:preview": "pnpm --filter @daoewo/mobile preview:generate",
    "ios:mobile:preview": "pnpm --filter @daoewo/mobile ios:preview",
    "android:mobile:preview": "pnpm --filter @daoewo/mobile android:preview",
    "dev:ait": "pnpm --filter @daoewo/ait dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run test:core && pnpm run check:core:artifact && pnpm run test:catalog && pnpm run check:catalog:artifact && pnpm run test:ui && pnpm run test:functions && pnpm run test:mobile && pnpm run test:ait && pnpm run test:content && pnpm run test:scripts && pnpm run check:assets && pnpm run check:architecture && pnpm run check:docs",
    "test:core": "pnpm --filter @daoewo/product-core test",
    "test:catalog": "pnpm --filter @daoewo/product-catalog test",
    "test:ui": "pnpm --filter @daoewo/product-ui test",
    "test:functions": "pnpm --filter @daoewo/functions test",
    "test:functions:rules": "pnpm --filter @daoewo/functions test:rules",
    "test:mobile": "pnpm --filter @daoewo/mobile test --runInBand",
    "test:ait": "pnpm --filter @daoewo/ait test --runInBand",
    "test:content": "pnpm --filter @daoewo/content-pipeline check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "generate:catalog": "pnpm --filter @daoewo/product-catalog generate",
    "check:catalog": "pnpm --filter @daoewo/product-catalog check",
    "check:core:artifact": "git diff --exit-code -- packages/product-core/dist",
    "check:catalog:artifact": "git diff --exit-code -- packages/product-catalog/dist",
    "check:assets": "python3 scripts/validate_registration_assets.py --manifest assets/registration-icons.manifest.json --root .",
    "check:architecture": "bash scripts/check_architecture.sh",
    "check:docs": "bash scripts/check_docs.sh",
    "check:release": "bash scripts/check_release_readiness.sh",
    "check:mobile": "bash scripts/check_mobile_target.sh",
    "check:ait": "bash scripts/check_ait_target.sh && pnpm --filter @daoewo/ait typecheck && pnpm --filter @daoewo/ait build",
    "build:ait": "pnpm --filter @daoewo/ait build",
    "build:android": "pnpm --filter @daoewo/mobile android --mode release",
    "bootstrap:mobile": "bash scripts/bootstrap_mobile.sh",
    "bootstrap:ait": "bash scripts/bootstrap_ait.sh"
  }
}
