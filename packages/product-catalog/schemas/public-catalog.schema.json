{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daoewo.seorilabs.com/schemas/public-catalog.schema.json",
  "title": "Daoewo Public Catalog Runtime Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "version", "sourceDigest", "decks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "const": "daoewo-v1" },
    "version": { "type": "integer", "minimum": 1 },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "decks": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": { "$ref": "#/$defs/deck" }
    }
  },
  "$defs": {
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayOrder",
        "title",
        "description",
        "category",
        "locale",
        "contentLanguage",
        "tier",
        "priority",
        "sourceType",
        "availability",
        "version",
        "cardCount",
        "chunkSize",
        "tags",
        "license",
        "publishedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "displayOrder": { "type": "integer", "minimum": 0, "maximum": 13 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "enum": ["language", "certification", "career", "general-knowledge", "k12-secondary"] },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "contentLanguage": { "enum": ["ko", "en", "ja"] },
        "tier": { "enum": ["free", "pro"] },
        "priority": { "enum": ["P1", "P2", "P3"] },
        "sourceType": { "enum": ["curated-import", "ai-assisted-operator-batch"] },
        "availability": { "enum": ["coming-soon", "published"] },
        "version": { "type": "integer", "minimum": 1 },
        "cardCount": { "type": ["integer", "null"], "minimum": 1 },
        "chunkSize": { "const": 200 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ids", "attributions", "distributionNotice"],
          "properties": {
            "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "attributions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "distributionNotice": { "type": "string", "minLength": 1 }
          }
        },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
