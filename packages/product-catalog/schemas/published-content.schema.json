{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daoewo.seorilabs.com/schemas/published-content.schema.json",
  "title": "Daoewo Server-only Published Content Export",
  "type": "object",
  "additionalProperties": { "$ref": "#/$defs/deckContent" },
  "$defs": {
    "deckContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckId", "version", "chunkSize", "cardCount", "publishedAt", "publicationDigest", "chunks"],
      "properties": {
        "deckId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "version": { "type": "integer", "minimum": 1 },
        "chunkSize": { "const": 200 },
        "cardCount": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "publicationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chunkIndex", "checksum", "cards"],
            "properties": {
              "chunkIndex": { "type": "integer", "minimum": 0 },
              "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "cards": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": { "$ref": "https://daoewo.seorilabs.com/schemas/card.schema.json" }
              }
            }
          }
        }
      }
    }
  }
}
