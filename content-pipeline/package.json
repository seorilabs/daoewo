{
  "name": "@daoewo/content-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "다외워 공급자 전용 콘텐츠 생성, 검수, 승인, 청크 배포 파이프라인",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "validate": "node src/cli.mjs validate",
    "backlog": "node src/cli.mjs backlog",
    "batch:run": "node src/cli.mjs batch-run",
    "batch:status": "node src/cli.mjs batch-status",
    "import:vocab-swipe": "node src/cli.mjs import-vocab-swipe --all",
    "smoke": "node src/cli.mjs smoke --offline",
    "test": "node --test tests/*.test.mjs",
    "check": "node src/cli.mjs validate && node --test tests/*.test.mjs && node src/cli.mjs smoke --offline"
  }
}
