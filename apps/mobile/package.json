        "NativeDaoewoNotifications": "RCTNativeDaoewoNotifications"
      }
    }
  },
  "dependencies": {
    "@daoewo/product-core": "workspace:*",
    "@daoewo/product-catalog": "workspace:*",
    "@daoewo/product-ui": "workspace:*",
    "@noble/hashes": "2.2.0",
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-firebase/analytics": "25.1.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/app-check": "25.1.0",
    "@react-native-firebase/auth": "25.1.0",
    "@react-native-firebase/crashlytics": "25.1.0",
    "@react-native-firebase/firestore": "25.1.0",
    "@react-native-firebase/functions": "25.1.0",
    "@react-native-firebase/messaging": "25.1.0",
    "@react-native-firebase/remote-config": "25.1.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-iap": "15.4.0",
    "react-native-nitro-modules": "0.36.1",
    "react-native-safe-area-context": "5.6.2"
