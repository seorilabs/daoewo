{
  "name": "@daoewo/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest"
  },
  "codegenConfig": {
